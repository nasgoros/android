<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- Recovery file manager; retain the Lineage UI and installer. -->
  <remove-project name="LineageOS/android_bootable_recovery" path="bootable/recovery" />
  <project path="bootable/recovery" name="nasgoros/android_bootable_recovery" revision="refs/heads/17.0" />

  <!-- First boot uses AOSP Provision. The fork provides an empty phony
       LineageSetupWizard module: no APK, setup activities, or partner RRO. -->
  <remove-project name="LineageOS/android_packages_apps_SetupWizard" path="packages/apps/SetupWizard" />
  <project path="packages/apps/SetupWizard" name="nasgoros/android_packages_apps_SetupWizard" revision="refs/heads/17.0" />

  <!-- nasgorOS additions -->
  <project path="vendor/nasgoros" name="nasgoros/android_vendor_nasgoros" revision="refs/heads/17.0" >
    <linkfile src="product.mk" dest="vendor/extra/product.mk" />
  </project>
  <project path="packages/apps/NasgorSettings" name="nasgoros/android_packages_apps_NasgorSettings" revision="refs/heads/17.0" />

  <include name="snippets/nasgor-crdroid.xml" />

</manifest>
